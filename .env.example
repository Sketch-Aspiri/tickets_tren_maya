APP_NAME="Tren Maya Tickets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Se guarda en UTC y se muestra en hora local (Quintana Roo).
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Cancun

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En servidor usa `daily` (rotacion de logs); `single` crece sin limite.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 escucha solo en localhost. Credenciales propias de este sitio (nunca las del dashboard).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tickets
DB_USERNAME=tickets_user
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sesion. Por defecto (sin definir estas claves) config/session.php las deja
# seguras fuera de local/testing: cifrada, solo HTTPS y SameSite=lax. En staging/produccion la
# app NO arranca si la cookie no es segura, APP_DEBUG=true o APP_URL no es https.
# SESSION_SECURE_COOKIE=false es solo para local (HTTP); en staging/produccion debe ser true o quedar sin definir.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Proxy inverso (Nginx/CloudPanel) y Host header. Listas separadas por comas.
# TRUSTED_PROXIES: IP(s) del proxy que pasa X-Forwarded-Proto; sin ella la app no ve HTTPS y no envia HSTS.
#   Ejemplo staging/produccion: TRUSTED_PROXIES=127.0.0.1
# TRUSTED_HOSTS: dominios aceptados en la cabecera Host. Si se omite, staging/produccion aceptan
#   solo el host exacto de APP_URL. Ejemplo: TRUSTED_HOSTS=tickets.example.test
# Vacios en local (TrustHosts no actua en local ni en pruebas).
TRUSTED_PROXIES=
TRUSTED_HOSTS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Correo saliente (SMTP). En local se escribe al log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="tickets@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Politica de contrasenas: rechaza contrasenas filtradas (consulta la API de Have I Been Pwned).
PASSWORD_CHECK_BREACHED=true

# Solo local: contrasena de las cuentas demo (si se omite, el seeder genera una aleatoria). Debe cumplir la politica de contrasenas.
DEMO_USER_PASSWORD=

# Adjuntos de tickets (disco privado storage/app/private). Ver config/tickets.php.
ATTACHMENT_MAX_KB=10240
ATTACHMENT_MAX_PER_TICKET=10

# Actividades recurrentes: hasta cuantos dias por delante de hoy (hora de Cancun) genera instancias el comando
# activities:generate-recurring, y a que hora local se ejecuta diariamente desde el scheduler. Ver config/tickets.php.
RECURRENCE_HORIZON_DAYS=14
RECURRENCE_SCHEDULE_AT=02:00

VITE_APP_NAME="${APP_NAME}"
