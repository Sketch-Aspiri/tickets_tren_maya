{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-bash.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(composer install)",
      "Bash(composer show *)",
      "Bash(composer audit)",
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(php artisan serve)",
      "Bash(php artisan route:list)",
      "Bash(php artisan test)",
      "Bash(php artisan test *)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate:status)",
      "Bash(./vendor/bin/pint)",
      "Bash(./vendor/bin/pint *)",
      "Bash(./vendor/bin/phpstan *)"
    ]
  }
}
